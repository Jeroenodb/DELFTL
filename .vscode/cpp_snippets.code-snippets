        "body": "vector<pi> adj[mxN];\nvector<array<int,3>> updates[mxN];\n\nbitset<mxN> vis;\nint sz[mxN];\nvector<pi> par[mxN];\nauto update(int at,int d, int c, int t) {\n    for(auto& [p,dist]: par[at]) {\n        if(dist<=d) {\n            auto& v = updates[p];\n            int myd = d-dist;\n            while(!v.empty() and v.back()[0]<=myd) v.pop_back();\n            v.push_back({myd,c,t});\n        }\n    }\n}\nint D,P;\nvoid dfsz(int at) {\n    if(P) par[at].push_back({P,D});\n    sz[at]=1;\n    vis[at]=true;\n    for(auto [to,w]: adj[at])if(!vis[to]) {\n        D+=w;\n        dfsz(to);\n        D-=w;\n        sz[at]+=sz[to];\n    }\n    vis[at]=false;\n}\nint centroid(int at) {\n    int from=at, n=sz[at];\n    bool done=false;\n    while(!done) {\n        done=true;\n        for(auto [to,w]: adj[at]) if(!vis[to] and to!=from) {\n            if(sz[to]*2>n) {\n                from = at, at = to, done=false;\n                break;\n            }\n        }\n    }\n    return at;\n}\nvoid decomp(int at, int p, int ww) {\n    D=ww,P=p;\n    dfsz(at);\n    int c = centroid(at);\n    par[c].push_back({c,0});\n    vis[c]=true;\n    for(auto [to,w]: adj[c]) if(!vis[to]) {\n        decomp(to,c,w);\n    }\n}",
