        "body": "std::mt19937 rng(std::chrono::steady_clock::now().time_since_epoch().count());\ntemplate<class I> I rnd(I l,I r){return std::uniform_int_distribution<I>(l,r)(rng);}\nconst int bound=600;\ntemplate<typename F> struct flow {\n    static constexpr F INF = numeric_limits<F>().max()/3;\n    int n;\n    vector<basic_string<int>> adj;\n    struct edge {\n        F c,f;\n        int to;\n    };\n    vector<edge> es;\n    void addE(int u, int v, F w, bool directed=true) {\n        // cout << u << ' ' << v << ' ' << w << '\\n';\n        int ei=es.size();\n        adj[u].push_back(ei);\n        adj[v].push_back(ei+1);\n        es.push_back({w,0,v});\n        es.push_back({directed?0:w,0,u});\n    }\n    vi d,q;\n    static constexpr int oo = 1e9;\n    void bfs(int s) {\n        fill(all(d),oo);\n        q.clear();\n        auto process = [&](int at, int nd) {\n            if(d[at]>nd) {\n                q.push_back(at);\n                d[at]=nd;\n            }\n        };\n        process(s,0);\n        for(int i=0;i<(int)q.size();++i) {\n            int at = q[i];\n            for(auto ei : adj[at]) {\n                auto& e = es[ei];\n                if(e.c>e.f) process(e.to,d[at]+1);\n            }\n        }\n    }\n    vector<bool> vis;\n    int t;\n    F dfs(int at, F mn=INF) {\n        if(at==t) return mn;\n        vis[at]=1;\n        for(auto ei : adj[at]) {\n            auto& e = es[ei];\n            if(e.c>e.f and !vis[e.to] and d[e.to]==d[at]+1 ) {\n                if(F tmp = dfs(e.to,min(mn,F(e.c-e.f)))) {\n                    e.f+=tmp;\n                    es[ei^1].f-=tmp;\n                    return tmp;\n                }\n            }\n        }\n        return 0;\n    }\n    ll run(int s, int tt) {\n        \n        t=tt;\n        ll ans=0;\n        int iters=0;\n        while(true) {\n            iters++;\n            assert(iters<=bound);\n            for(auto& v : adj) shuffle(all(v),rng);\n            bfs(s);\n            if(d[t]==oo) return ans;\n            vis.assign(n,0);\n            for(auto ei : adj[s]) {\n                auto& e = es[ei];\n                if(e.f==0) {\n                    auto res = dfs(e.to);\n                    if(res) {\n                        e.f++;\n                        ans+=res;\n                    }\n                }\n            }\n        }\n    }\n    flow(int nn) : n(nn),adj(nn),d(nn) {\n        q.reserve(nn);\n    }\n};",
