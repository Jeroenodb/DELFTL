        "body": "struct flow {\n    // Source is Node 0;\n    // Sink is node n-1\n    // Uses push relabel algorithm\n    struct edge {\n        ll f,c;\n        int to;\n    };\n    typedef vector<edge> ve;\n    vector<vector<int>> adj;\n    vector<edge> edges;\n    vector<ll> excess;\n    vector<int> h, arcp;\n    int n;\n    flow(int _n) {\n        n=_n;\n        h.resize(n);\n        excess.resize(n);\n        adj.resize(n);\n        arcp.resize(n);\n    }\n    void addEdge(int a, int b, ll w, bool directed = true) {\n        adj[a].push_back((int)edges.size());\n        adj[b].push_back((int)edges.size()+1);\n        edges.push_back({0,w,b});\n        edges.push_back({0,directed?0:w,a});\n    }\n    queue<int> q; \n    void push(int at) {\n        for(int i : adj[at]) {\n            edge& e = edges[i];\n            if(e.f<e.c and h[at] > h[e.to]) {\n                ll tmp = min(e.c-e.f, excess[at]);\n                excess[at]-=tmp;\n                e.f+=tmp;\n                if(e.to!=n-1 and excess[e.to]==0) q.push(e.to);\n                excess[e.to] += tmp;\n                edge& o = edges[i^1];\n                o.f-=tmp;\n            }\n            if(excess[at]==0) return;\n        }\n        bool renew = false;\n        for(int i : adj[at]) {\n            auto& e = edges[i];\n            if(h[e.to]>=h[at]) {\n                h[at]+=1;\n                renew = true;\n            }\n        }\n        if(renew) {\n            q.push(at);\n        }\n    }\n    ll solve() {\n        h[0] = n;\n        q.push(0);\n        excess[0] = 1e18;\n        while(!q.empty()) {\n            int at = q.front();\n            q.pop();\n            push(at);\n\n        }\n        return excess[n-1];\n    }\n};",
        "description": "Snippet for PrepushMaxFlow"
    },
