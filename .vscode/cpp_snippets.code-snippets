        "body": "typedef __int128 Int;\narray<Int,3> extendedgcd(Int a,Int b) {\n    auto oa=a,ob=b;\n    Int x=0,y=1,u=1,v=0;\n    while(a!=0) {\n        auto q=b/a,r=b%a;\n        auto m=x-u*q,n=y-v*q;\n        b=a, a=r, x=u,y=v,u=m,v=n;\n    }\n    assert(oa*x+ob*y==b);\n    return {x,y,b};\n}\nstruct chineseremainder {\n    Int a=0,m=0;\n    void add(Int b, Int n) {\n        b=(b%n+n)%n;\n        if(m==-1) return;\n        if(m==0) {\n            a=b;\n            m=n;\n            return;\n        }\n        auto [u,v,g] = extendedgcd(m,n);\n        if((a-b)%g!=0) {\n            m=-1;return;\n        }\n        Int lam = (a-b)/g;\n        m=m/g*n;\n        a = b + (lam*v)%m*n;\n\n        a = (a%m+m)%m;\n    }\n    Int get(Int x) {return a+m*x;}\n};",
