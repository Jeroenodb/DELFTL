  }\n};\nostream& operator<<(ostream& c, const bignum& l) {\n    c << l.d.back();\n    for(int i=l.d.size()-1; --i>0;) {\n        c << setw(9) << setfill('0') << l.d[i];\n    }\n    return c;\n}",
