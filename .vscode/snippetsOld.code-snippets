	  "Disjoint Set Union": {
		"scope": "cpp",
		"prefix": "dsu",
		"body": [
		  "struct DSU{",
		  "    vector<int> sz,parent;",
		  "    int components;",
		  "    DSU(int n) {",
		  "        sz.assign(n,1);",
		  "        components = n;",
		  "        parent.resize(n);",
		  "        iota(all(parent),0);",
		  "    }",
		  "    void link(int a, int b) {",
		  "        components--;",
		  "        if(sz[a]<sz[b]) {",
		  "            swap(a,b);",
		  "        }",
		  "        sz[a]+=sz[b];",
		  "        parent[b] = a;",
		  "    }",
		  "    bool unite(int a, int b) {",
		  "        int pa = find(a),pb = find(b);",
		  "        if(pa!=pb) link(pa,pb);",
		  "        return pa!=pb;",
		  "    }",
		  "    int find(int a) {",
		  "        if(a==parent[a]) return a;",
		  "        return parent[a] = find(parent[a]);",
		  "    }",
		  "};"
		],
		"description": "class for disjoint set union data structure"
